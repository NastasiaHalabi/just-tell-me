APP_ENV=dev
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=sqlite:///./just_tell_me.db
# PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/just_tell_me

# Optional LLM planner. Leave empty to use the deterministic Lebanese planner.
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# CORS origins for local Flutter / web clients
CORS_ORIGINS=http://localhost:*,http://127.0.0.1:*
